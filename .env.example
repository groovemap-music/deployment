# Docker Compose Environment Variables
# Copy this file to .env and update values as needed

# Required internal images. Resolve an approved release tag to its registry
# digest, then replace each placeholder. Tags alone and `latest` are rejected.
# `just env-init` fills these from the reviewed release digests instead.
DATABASE_SCHEMA_IMAGE=ghcr.io/groovemap-music/database-schema@sha256:REPLACE_WITH_64_HEX_CHARACTERS
CATALOG_API_IMAGE=ghcr.io/groovemap-music/catalog-api@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_INGESTION_IMAGE=ghcr.io/groovemap-music/discogs-ingestion@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_INGESTION_IMAGE=ghcr.io/groovemap-music/musicbrainz-ingestion@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_GRAPH_ENRICHER_IMAGE=ghcr.io/groovemap-music/discogs-graph-enricher@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_GRAPH_ENRICHER_IMAGE=ghcr.io/groovemap-music/musicbrainz-graph-enricher@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_SQL_LOADER_IMAGE=ghcr.io/groovemap-music/discogs-sql-loader@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_SQL_LOADER_IMAGE=ghcr.io/groovemap-music/musicbrainz-sql-loader@sha256:REPLACE_WITH_64_HEX_CHARACTERS
OPERATIONS_CONSOLE_IMAGE=ghcr.io/groovemap-music/operations-console@sha256:REPLACE_WITH_64_HEX_CHARACTERS
GRAPH_EXPLORER_IMAGE=ghcr.io/groovemap-music/graph-explorer@sha256:REPLACE_WITH_64_HEX_CHARACTERS
ANALYTICS_ENGINE_IMAGE=ghcr.io/groovemap-music/analytics-engine@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Compose profiles. Leave unset on first load: extractor-musicbrainz, brainzgraphinator and
# brainztableinator sit behind the "musicbrainz" profile because the Discogs import has to
# finish before the MusicBrainz import starts (docs/maintenance.md). Once Discogs has
# drained, set COMPOSE_PROFILES=musicbrainz to bring the MusicBrainz path up and keep it
# up on later `docker compose up` runs.
# COMPOSE_PROFILES=musicbrainz

# Source-build compatibility metadata. Deployment consumes released images and
# the Compose files do not interpolate these values.
PYTHON_VERSION=3.14
PYTHON_VERSION_FULL=3.14.7
PYTHON_VERSION_SHORT=py314

# User/Group IDs for container processes
# These should match your host user to avoid permission issues
# Use 'id -u' and 'id -g' on Linux/Mac to get your values
UID=1000
GID=1000

# Direct-process development reference. docker-compose.yml declares its
# container environment explicitly, so changing these entries does not override
# a Compose service; use a reviewed docker-compose.override.yml for that.
# These values are suitable only for local development.
RABBITMQ_USERNAME=groovemap
RABBITMQ_PASSWORD=groovemap
RABBITMQ_HOST=localhost
# Queue depth and publish/ack rates are read from rabbitmq_prometheus, not the
# management API (ADR 0017). The operations console and catalog API read it here.
RABBITMQ_PROMETHEUS_URL=http://localhost:15692
# Operations console history and links. VICTORIA_METRICS_URL is read server-side.
# GRAFANA_URL is the base of the browser's deep links, so it must be reachable from the
# browser; TRACES_URL defaults to it. Compose sets GRAFANA_API_URL (in-network) for the
# console's own alert fetches.
# The optional Grafana Viewer token is a file secret (GRAFANA_TOKEN_FILE), never an
# environment value; see docs/maintenance.md.
VICTORIA_METRICS_URL=http://localhost:8428
GRAFANA_URL=http://localhost:3000
TRACES_URL=http://localhost:3000
NEO4J_HOST=localhost
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=groovemap
# POSTGRES_HOST may include a port (e.g. pgbouncer:6432) to target a pooler;
# otherwise POSTGRES_PORT (default 5432) is used.
POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_USERNAME=groovemap
POSTGRES_PASSWORD=groovemap
POSTGRES_DATABASE=groovemap
VALKEY_HOST=localhost
# VALKEY_PORT=6379
# Set only if your Valkey enforces auth (requirepass). Supports VALKEY_PASSWORD_FILE for Docker secrets.
# VALKEY_PASSWORD=
DISCOGS_ROOT=/discogs-data

# Optional base-stack encryption. The production overlay uses the file-backed
# secrets created by `just secrets-bootstrap`; do not put production credentials
# in .env. This variable is only consulted after uncommenting the corresponding
# base docker-compose.yml setting.
# Generate with: uv run python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
ENCRYPTION_MASTER_KEY=CHANGE_ME_IN_PRODUCTION

# Optional production sizing. Credentials come from Docker secret files.
# `just deploy` sizes NEO4J_HEAP_SIZE, NEO4J_PAGECACHE_SIZE, NEO4J_MEMORY_LIMIT and
# NEO4J_TRANSACTION_MEMORY_MAX from the host's memory and treats this unchanged 2G line as
# unset (docs/configuration.md). Keep the transaction cap below the heap (deploy uses 70%).
NEO4J_HEAP_SIZE=2G
# NEO4J_PAGECACHE_SIZE=16g
# NEO4J_MEMORY_LIMIT=48G
# NEO4J_TRANSACTION_MEMORY_MAX=8G

# Optional source-process reference values. These are not Compose interpolation
# inputs; use a reviewed override file to change a deployed container.
# PERIODIC_CHECK_DAYS=15  # How often extractor checks for new data
# STARTUP_DELAY=10        # Seconds to wait before starting services
# LOG_LEVEL=INFO          # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Optional: Consumer Management (Graphinator, Tableinator)
# CONSUMER_CANCEL_DELAY=300    # Seconds before canceling idle consumers (default: 300)
# QUEUE_CHECK_INTERVAL=3600    # Seconds between queue checks when idle (default: 3600)

# Optional: Batch Processing - Neo4j (Graphinator)
# NEO4J_BATCH_MODE=true           # Enable batch processing (default: true)
# NEO4J_BATCH_SIZE=100            # Records per batch (default: 100)
# NEO4J_BATCH_FLUSH_INTERVAL=5.0  # Seconds between flushes (default: 5.0)

# Optional: Batch Processing - PostgreSQL (Tableinator)
# POSTGRES_BATCH_MODE=true           # Enable batch processing (default: true)
# POSTGRES_BATCH_SIZE=100            # Records per batch (default: 100)
# POSTGRES_BATCH_FLUSH_INTERVAL=5.0  # Seconds between flushes (default: 5.0)

# Optional: catalog-DLQ size-cap policy (gm-deployment-8mb.1). RabbitMQ cannot
# change an existing classic queue's type, so the four catalog consumers'
# DLQs stay classic and are bounded from the broker side instead, by a policy
# matched on name (pattern ^groovemap-.*\.dlq$) rather than a queue redeclare.
# scripts/rabbitmq-dlq-policy-init.sh (a one-shot service that runs after the
# broker is healthy) declares the policy from these; no service code is
# touched. See docs/admin-guide.md#dlq-size-cap-policy.
# RABBITMQ_DLQ_MAX_LENGTH=50000          # Max messages per DLQ (default: 50000)
# RABBITMQ_DLQ_MAX_LENGTH_BYTES=536870912  # Max bytes per DLQ (default: 512 MiB)
# RABBITMQ_DLQ_OVERFLOW=drop-head        # drop-head | reject-publish (default: drop-head)

# Embedding pipeline (ADR 0013's 2026-09-24 amendment) — analytics-engine's
# one-shot `analytics-engine-embeddings` entry point authenticates under this
# dedicated login, a member of database-schema's NOLOGIN embedding_pipeline
# group role, instead of the POSTGRES_USERNAME superuser every other service
# uses. scripts/provision-embedding-pipeline-login.sh grants the role
# membership; docs/maintenance.md#monthly-embedding-refresh documents the
# monthly trigger (just embeddings-run) and its PostgreSQL 19 + pgvector
# dependency, which this stack does not have yet.
EMBEDDING_PIPELINE_POSTGRES_USERNAME=embedding_pipeline
EMBEDDING_PIPELINE_POSTGRES_PASSWORD=groovemap

# Set at invocation time, never here: the dump this run embeds changes every
# month, and a stale value would silently re-embed the wrong one.
#   SOURCE_DUMP_ID=discogs-2026-09 SOURCE_DUMP_DATE=2026-09-01 just embeddings-run

# Identity Ledger freshness (catalog-api c31703b). docker-compose.yml sets
# IDENTITY_LEDGER_REFRESH_ENABLED=true on the api service (catalog-api defaults it to
# false); the production overlay and the smoke overlays inherit it. The four variables
# below are catalog-api settings, not Compose interpolation inputs: they show the
# defaults, and changing one in a deployed container takes a reviewed override file.
# Re-attachment and backfill runs refresh the ledger inline whether or not the poll runs.
# IDENTITY_LEDGER_REFRESH_ENABLED=true    # Run the change-detection poll (catalog-api default: false)
# IDENTITY_LEDGER_REFRESH_INTERVAL=300    # Seconds between polls (default: 300, at least 1)
# IDENTITY_LEDGER_REFRESH_QUIET=600       # Seconds the sources must hold still before a refresh (default: 600)
# IDENTITY_LEDGER_MAX_STALENESS=21600     # Refresh a changed ledger at this age even during writes (default: 21600, 6 h)

# Published host ports and bind addresses. Every default below reproduces the
# stock mapping, so leave these commented unless a port conflicts on your host.
# Only the host side changes; containers keep their internal ports, so set
# APP_BASE_URL, GRAFANA_URL and TRACES_URL to match a moved port.
# Bind addresses: leave WEB_BIND_ADDRESS and DATA_BIND_ADDRESS unset to publish on
# all interfaces (today's behavior), or set an IP such as 127.0.0.1 or a LAN address.
# INTERNAL_BIND_ADDRESS covers the ports that are loopback-only (RabbitMQ metrics in
# every stack; Valkey, VictoriaMetrics and VictoriaTraces in the production overlay).
# WEB_BIND_ADDRESS=                         # Grafana, API, dashboard, Explore
# DATA_BIND_ADDRESS=                        # PostgreSQL, Neo4j, RabbitMQ AMQP/management; base-stack Valkey, VictoriaMetrics, VictoriaTraces
# INTERNAL_BIND_ADDRESS=127.0.0.1
# GRAFANA_HOST_PORT=3000
# API_HOST_PORT=8004
# API_HEALTH_HOST_PORT=8005
# DASHBOARD_HOST_PORT=8003
# EXPLORE_HOST_PORT=8006
# EXPLORE_HEALTH_HOST_PORT=8007
# POSTGRES_HOST_PORT=5433                   # container port is 5432
# NEO4J_HTTP_HOST_PORT=7474
# NEO4J_BOLT_HOST_PORT=7687
# RABBITMQ_AMQP_HOST_PORT=5672
# RABBITMQ_MANAGEMENT_HOST_PORT=15672
# RABBITMQ_METRICS_HOST_PORT=15692
# VALKEY_HOST_PORT=6379
# VICTORIA_METRICS_HOST_PORT=8428
# VICTORIA_TRACES_HOST_PORT=10428

# Console sign-in without TLS (production overlay). The console's session cookie is Secure,
# which a browser drops on plain http away from localhost, so sign-in on http://<lan-ip>:8003
# silently returns to the login form. The fix is a TLS reverse proxy in front (set APP_BASE_URL
# to its https:// address). On a trusted LAN only, set this to true to turn the Secure attribute
# off for the console; then recreate it: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --no-deps dashboard
# `just deploy` explains this and offers to set it. Only the exact value true counts.
# GROOVEMAP_ALLOW_INSECURE_CONSOLE=true

# Existing PostgreSQL and Valkey (production overlay only; docs/homelab.md, Existing PostgreSQL
# and Valkey). Unset or local: the stack runs its own postgres and valkey, as always. external:
# GrooveMap uses the server below instead, and `just deploy` adds docker-compose.external-*.yml.
# `just deploy` refuses external until the reviewed images support it (EXTERNAL_STORE_FLOORS in
# scripts/check-images.py) and until you have written the credentials yourself:
# secrets/postgres_username.txt and secrets/postgres_password.txt (the GrooveMap role), and
# secrets/valkey_password.txt. The database, role and pg_trgm must exist already.
# TLS is on by default for both: write the CA that signed each server's certificate to
# secrets/postgres_ca.crt and secrets/valkey_ca.crt. A cleartext connection to a server that is not
# on this machine is refused unless its ALLOW_PLAINTEXT opt-out is true: anyone on the network path
# could then read the password and the data and impersonate the server.
# While a store is external, `just deploy` also keeps COMPOSE_FILE in this file (do not edit it),
# so a bare `docker compose` uses the same files.
# GROOVEMAP_POSTGRES=external
# EXTERNAL_POSTGRES_HOST=db.lan                # host.docker.internal for a server on this host
# EXTERNAL_POSTGRES_PORT=5432                  # a PgBouncer must pool by session
# EXTERNAL_POSTGRES_DATABASE=groovemap         # GrooveMap's own database, never postgres
# EXTERNAL_POSTGRES_SSLMODE=verify-full        # verify-ca, require; disable/allow/prefer are cleartext
# EXTERNAL_POSTGRES_ALLOW_PLAINTEXT=false
# GROOVEMAP_VALKEY=external
# EXTERNAL_VALKEY_HOST=cache.lan
# EXTERNAL_VALKEY_PORT=6379
# EXTERNAL_VALKEY_DB=0
# EXTERNAL_VALKEY_KEY_PREFIX=groovemap:        # required; no other application may use it
# EXTERNAL_VALKEY_TLS=true
# EXTERNAL_VALKEY_TLS_VERIFY_HOSTNAME=true
# EXTERNAL_VALKEY_ALLOW_PLAINTEXT=false
