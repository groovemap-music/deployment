# Docker Compose Environment Variables
# Copy this file to .env and update values as needed

# Required internal images. Resolve an approved release tag to its registry
# digest, then replace each placeholder. Tags alone and `latest` are rejected.
DATABASE_SCHEMA_IMAGE=ghcr.io/groovemap-music/database-schema@sha256:REPLACE_WITH_64_HEX_CHARACTERS
CATALOG_API_IMAGE=ghcr.io/groovemap-music/catalog-api@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_INGESTION_IMAGE=ghcr.io/groovemap-music/discogs-ingestion@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_INGESTION_IMAGE=ghcr.io/groovemap-music/musicbrainz-ingestion@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_GRAPH_ENRICHER_IMAGE=ghcr.io/groovemap-music/discogs-graph-enricher@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_GRAPH_ENRICHER_IMAGE=ghcr.io/groovemap-music/musicbrainz-graph-enricher@sha256:REPLACE_WITH_64_HEX_CHARACTERS
DISCOGS_SQL_LOADER_IMAGE=ghcr.io/groovemap-music/discogs-sql-loader@sha256:REPLACE_WITH_64_HEX_CHARACTERS
MUSICBRAINZ_SQL_LOADER_IMAGE=ghcr.io/groovemap-music/musicbrainz-sql-loader@sha256:REPLACE_WITH_64_HEX_CHARACTERS
OPERATIONS_CONSOLE_IMAGE=ghcr.io/groovemap-music/operations-console@sha256:REPLACE_WITH_64_HEX_CHARACTERS
GRAPH_EXPLORER_IMAGE=ghcr.io/groovemap-music/graph-explorer@sha256:REPLACE_WITH_64_HEX_CHARACTERS
ANALYTICS_ENGINE_IMAGE=ghcr.io/groovemap-music/analytics-engine@sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Python version configuration
PYTHON_VERSION=3.14
PYTHON_VERSION_FULL=3.14.7
PYTHON_VERSION_SHORT=py314

# User/Group IDs for container processes
# These should match your host user to avoid permission issues
# Use 'id -u' and 'id -g' on Linux/Mac to get your values
UID=1000
GID=1000

# Development Configuration (docker-compose.yml)
# These use default passwords suitable for local development
RABBITMQ_USERNAME=groovemap
RABBITMQ_PASSWORD=groovemap
RABBITMQ_HOST=localhost
NEO4J_HOST=localhost
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=groovemap
# POSTGRES_HOST may include a port (e.g. pgbouncer:6432) to target a pooler;
# otherwise POSTGRES_PORT (default 5432) is used.
POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
POSTGRES_USERNAME=groovemap
POSTGRES_PASSWORD=groovemap
POSTGRES_DATABASE=groovemap
REDIS_HOST=localhost
# REDIS_PORT=6379
# Set only if your Redis enforces auth (requirepass). Supports REDIS_PASSWORD_FILE for Docker secrets.
# REDIS_PASSWORD=
DISCOGS_ROOT=/discogs-data

# Optional base-stack encryption. The production overlay uses the file-backed
# secrets created by `just secrets-bootstrap`; do not put production credentials
# in .env. This variable is only consulted after uncommenting the corresponding
# base docker-compose.yml setting.
# Generate with: uv run python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
ENCRYPTION_MASTER_KEY=CHANGE_ME_IN_PRODUCTION

# Optional production sizing. Credentials come from Docker secret files.
NEO4J_HEAP_SIZE=2G

# Optional: Override service configuration
# PERIODIC_CHECK_DAYS=15  # How often extractor checks for new data
# STARTUP_DELAY=10        # Seconds to wait before starting services
# LOG_LEVEL=INFO          # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Optional: Consumer Management (Graphinator, Tableinator)
# CONSUMER_CANCEL_DELAY=300    # Seconds before canceling idle consumers (default: 300)
# QUEUE_CHECK_INTERVAL=3600    # Seconds between queue checks when idle (default: 3600)

# Optional: Batch Processing - Neo4j (Graphinator)
# NEO4J_BATCH_MODE=true           # Enable batch processing (default: true)
# NEO4J_BATCH_SIZE=100            # Records per batch (default: 100)
# NEO4J_BATCH_FLUSH_INTERVAL=5.0  # Seconds between flushes (default: 5.0)

# Optional: Batch Processing - PostgreSQL (Tableinator)
# POSTGRES_BATCH_MODE=true           # Enable batch processing (default: true)
# POSTGRES_BATCH_SIZE=100            # Records per batch (default: 100)
# POSTGRES_BATCH_FLUSH_INTERVAL=5.0  # Seconds between flushes (default: 5.0)
