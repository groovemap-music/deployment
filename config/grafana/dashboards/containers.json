          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"$service\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}} working set",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service) (container_spec_memory_limit_bytes{container_label_com_docker_compose_service=~\"$service\"} > 0)",
          "legendFormat": "{{container_label_com_docker_compose_service}} limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Container memory working set vs limit",
