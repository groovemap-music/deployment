          "editorMode": "code",
          "expr": "sum by (container_label_com_docker_compose_service) (changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{container_label_com_docker_compose_service}} restarts",
          "range": true,
