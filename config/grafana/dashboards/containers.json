    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "cAdvisor exposes no restart counter, so a restart is read as a change in the container's start time. An OOM event beside a restart is the cause of it.",
