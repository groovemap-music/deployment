  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Derived from spans by the collector, so every instrumented operation is counted without a service emitting a metric for it.",
